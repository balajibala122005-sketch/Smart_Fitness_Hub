# Gym Hub Environment Configuration Example
# Copy this file to .env and adjust values for production deployment

# Database Configuration (XAMPP MySQL default)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/gym_hub?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# JWT Authentication (Replace with a secure 256-bit or greater key in production)
JWT_SECRET=GymHubSuperSecretKeyForJwtAuthenticationWhichMustBeAtLeast256BitsLong2026!
JWT_EXPIRATION_MS=86400000

# Server Port
PORT=8080
